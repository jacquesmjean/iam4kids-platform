# Copy to .env.local. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # server only — never expose to the browser
RESEND_API_KEY=
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
CRON_SECRET=                    # guards /api/v1/cron/*

# Staff console alerts by email (optional). The console notification always
# happens; email is added only when all three are set. The sender must be on
# a domain verified in the Resend account that owns RESEND_API_KEY.
ALERT_EMAIL_FROM=               # e.g. I AM 4 Kids Platform <alerts@mail.iam4kids.com>
ALERT_EMAIL_TO=                 # comma separated, e.g. mark@iam4kids.com
